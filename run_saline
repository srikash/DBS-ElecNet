#!/usr/bin/env bash
set -euo pipefail

# ============================
# Usage
# ============================
usage() {
    echo "Usage: $0 <nifti_file> <num_elec (1 or 2)> [--brain_mask PATH] [--synthseg PATH]"
    echo
    echo "A thin wrapper around the installed 'saline' CLI (saline-dbs on PyPI)."
    echo "SALINE handles the whole pipeline itself -- resampling, skull-stripping"
    echo "(SynthStrip), N4 bias correction, and segmentation (SynthSeg), all via"
    echo "Docker by default. If Docker isn't available, pass --brain_mask and/or"
    echo "--synthseg with your own precomputed files instead."
}

if [[ $# -lt 2 ]]; then
    usage
    exit 1
fi

nifti_file="$1"
num_elec="$2"
shift 2

extra_args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --brain_mask|--synthseg)
            extra_args+=("$1" "$2")
            shift 2
            ;;
        *)
            echo "Error: unknown argument: $1"
            usage
            exit 1
            ;;
    esac
done

# ============================
# Validate inputs
# ============================
if [[ ! -f "$nifti_file" ]]; then
    echo "Error: file not found: $nifti_file"
    exit 1
fi

if [[ "$num_elec" != "1" && "$num_elec" != "2" ]]; then
    echo "Error: num_elec must be 1 or 2"
    exit 1
fi

# ============================
# Run SALINE
# ============================
if [[ "$num_elec" -eq 2 ]]; then
    saline --input "$nifti_file" "${extra_args[@]+"${extra_args[@]}"}"
else
    saline single --input "$nifti_file" "${extra_args[@]+"${extra_args[@]}"}"
fi
